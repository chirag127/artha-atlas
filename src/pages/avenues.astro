---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const avenuesFile = fs.readFileSync(path.resolve('./src/data/avenues.yaml'), 'utf8');
const avenues = yaml.load(avenuesFile) as any[];

const categories = Array.from(new Set(avenues.map(a => a.category)));
---
<BaseLayout
  title="The Avenues Directory — Artha Atlas"
  description="Comprehensive encyclopedia of every Indian investment vehicle: direct equities, mutual funds, sovereign debt, real estate, REITs, AIFs, and gold."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'Avenues Directory' }]} />

    <header class="my-6 pb-6 border-b border-stone-200 dark:border-stone-800">
      <div class="inline-flex items-center space-x-2 text-xs font-mono font-semibold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-900 px-3 py-1 rounded-full mb-3">
        <span>📚 The Encyclopedia</span>
        <span>•</span>
        <span>{avenues.length} Regulated Instruments</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 dark:text-stone-50 tracking-tight leading-tight">
        The Investment Avenues Directory
      </h1>
      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 max-w-4xl mt-3 font-sans leading-relaxed">
        Select an asset class below to inspect mechanics, regulatory oversight, minimum ticket sizes, tax implications, and documented failure modes.
      </p>
    </header>

    <div class="space-y-12">
      {categories.map((category) => {
        const catAvenues = avenues.filter(a => a.category === category);
        return (
          <section class="space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-stone-200 dark:border-stone-800">
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-stone-900 dark:text-stone-100 flex items-center space-x-2">
                <span>{category}</span>
                <span class="text-xs font-sans text-stone-500 font-normal">({catAvenues.length} instruments)</span>
              </h2>
              <a href={`${base}/compare/`} class="text-xs text-amber-600 hover:underline font-medium">
                Compare in Table →
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {catAvenues.map((item) => (
                <div class="p-5 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs flex flex-col justify-between hover:border-amber-500/50 transition-colors">
                  <div>
                    <div class="flex items-center justify-between text-[11px] text-stone-500 mb-2">
                      <span class="font-mono bg-stone-100 dark:bg-stone-800 px-2 py-0.5 rounded font-semibold text-stone-700 dark:text-stone-300">
                        {item.regulator}
                      </span>
                      <span>Min: ₹{item.minTicket.toLocaleString('en-IN')}</span>
                    </div>

                    <h3 class="font-serif font-bold text-base text-stone-900 dark:text-stone-100 mb-2">
                      {item.name}
                    </h3>

                    <div class="space-y-1.5 text-xs text-stone-600 dark:text-stone-400 mb-4">
                      <div class="flex justify-between">
                        <span>Nominal Return:</span>
                        <span class="font-semibold text-stone-900 dark:text-stone-200">{item.historicalReturn}</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Real Return:</span>
                        <span class="font-semibold text-emerald-600 dark:text-emerald-400">{item.expectedRealReturn}</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Max Drawdown:</span>
                        <span class="font-mono text-red-600 dark:text-red-400">{item.maxDrawdown}</span>
                      </div>
                    </div>

                    <p class="text-[11px] text-stone-500 dark:text-stone-400 leading-relaxed border-t border-stone-100 dark:border-stone-800 pt-3 line-clamp-2">
                      <strong>Suitability:</strong> {item.suitability}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-xs">
                    <span class="text-[10px] text-stone-400">Lock-in: {item.lockInDays === 0 ? 'None' : `${item.lockInDays}d`}</span>
                    <a href={`${base}/compare/`} class="text-amber-600 hover:underline font-medium">
                      Compare Side-by-Side →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
