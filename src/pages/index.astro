---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricsCounter from '../components/MetricsCounter.tsx';
import fs from 'node:fs';
import yaml from 'js-yaml';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Load avenues
const avenuesFile = fs.readFileSync(path.resolve('./src/data/avenues.yaml'), 'utf8');
const avenues = yaml.load(avenuesFile) as any[];

const categories = [
  { name: "Public Equity", count: "12+ Instruments", risk: "Moderate to High", icon: "📈", desc: "Large, Mid, Small, Micro-caps, SME platforms, Factor investing, and ESOPs.", href: `${base}/avenues/` },
  { name: "Mutual Funds & ETFs", count: "36 SEBI Categories", risk: "Low to High", icon: "🏛️", desc: "Index funds, Factor ETFs, Active equity, Arbitrage, Balanced advantage, and TMFs.", href: `${base}/avenues/` },
  { name: "Fixed Income & Debt", count: "15+ Avenues", risk: "Low to Sovereign Zero", icon: "🛡️", desc: "RBI Retail Direct G-Secs, T-Bills, SDLs, PPF, SCSS, Corporate Bonds via OBPPs.", href: `${base}/avenues/` },
  { name: "Real Estate & REITs", count: "8 Avenues", risk: "Moderate", icon: "🏢", desc: "Commercial REITs, SM REITs fractional platforms, RERA, and direct property.", href: `${base}/avenues/` },
  { name: "Gold & Commodities", count: "6 Avenues", risk: "Moderate", icon: "🪙", desc: "SGB secondary market tranches, Gold ETFs, physical hallmarked bullion, and silver.", href: `${base}/avenues/` },
  { name: "High-Ticket Alternatives", count: "10 Avenues", risk: "High to Extreme", icon: "🚀", desc: "AIFs (Cat I/II/III), PMS strategies, SIFs, Private Credit, and Venture Debt.", href: `${base}/avenues/` },
  { name: "Personal Finance & FIRE", count: "10 Strategies", risk: "Low", icon: "🔥", desc: "Indian Safe Withdrawal Rates, sequence-of-returns risk, health shields, and NPS.", href: `${base}/allocation/` },
  { name: "Laws, Fraud & Red Flags", count: "12 Case Studies", risk: "Capital Protection", icon: "⚖️", desc: "BUDS Act 2019, Ponzi schemes, front-running, and forensic analyses (Saradha, PACL).", href: `${base}/scams-and-fraud/` }
];
---
<BaseLayout title="Artha Atlas — Every Indian Investment Avenue Compared Honestly">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-stone-200 dark:border-stone-800 bg-gradient-to-b from-amber-50/50 via-transparent to-transparent dark:from-stone-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center space-x-2 text-xs font-semibold px-3 py-1 rounded-full bg-amber-100/80 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
          <span>🇮🇳</span>
          <span>The Definitive Indian Wealth & Regulatory Encyclopedia</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-serif font-bold text-stone-900 dark:text-stone-50 tracking-tight leading-tight">
          Every Indian Investment Avenue, <span class="text-amber-600 dark:text-amber-400 italic">Compared Honestly.</span>
        </h1>

        <p class="text-base sm:text-xl text-stone-600 dark:text-stone-300 font-sans leading-relaxed">
          No broker commissions. No finfluencer hype. We analyze historical real returns, post-tax net yields, statutory failure modes, and Indian regulatory protections across every asset class.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href={`${base}/start-here/`}
            class="px-6 py-3 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm transition-all shadow-md hover:shadow-lg flex items-center space-x-2"
          >
            <span>🧭 Start Here: The Investor Roadmap</span>
          </a>
          <a
            href={`${base}/compare/`}
            class="px-6 py-3 rounded-lg bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 font-medium text-sm transition-all border border-stone-300 dark:border-stone-700 flex items-center space-x-2"
          >
            <span>⚖️ Open Comparison Engine</span>
          </a>
        </div>
      </div>

      <!-- Live Metric Counters -->
      <div class="mt-16 pt-12 border-t border-stone-200 dark:border-stone-800 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs">
          <div class="text-3xl sm:text-4xl font-serif text-amber-600">
            <MetricsCounter client:only="react" end={45} suffix="+" />
          </div>
          <div class="text-xs uppercase font-semibold text-stone-500 tracking-wider mt-1">Avenues Documented</div>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs">
          <div class="text-3xl sm:text-4xl font-serif text-emerald-600">
            <MetricsCounter client:only="react" end={500} suffix="+" />
          </div>
          <div class="text-xs uppercase font-semibold text-stone-500 tracking-wider mt-1">Glossary Definitions</div>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs">
          <div class="text-3xl sm:text-4xl font-serif text-indigo-600 dark:text-indigo-400">
            <MetricsCounter client:only="react" end={18} suffix="+" />
          </div>
          <div class="text-xs uppercase font-semibold text-stone-500 tracking-wider mt-1">Regulatory Statutes</div>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs">
          <div class="text-3xl sm:text-4xl font-serif text-red-600">
            <MetricsCounter client:only="react" end={0} prefix="₹" suffix=" Comm." />
          </div>
          <div class="text-xs uppercase font-semibold text-stone-500 tracking-wider mt-1">Distributor Bias</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Asset Class Exploration Grid -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 dark:text-stone-50 tracking-tight">
          Explore the Indian Investment Universe
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-400 mt-1">
          Deep, honest breakdowns of mechanics, historical returns, taxation, and risks for every avenue.
        </p>
      </div>
      <a href={`${base}/avenues/`} class="mt-4 md:mt-0 text-sm font-semibold text-amber-600 hover:text-amber-700 flex items-center space-x-1">
        <span>View all instruments</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((cat) => (
        <a
          href={cat.href}
          class="p-6 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 hover:border-amber-500/60 dark:hover:border-amber-500/60 transition-all duration-200 shadow-xs hover:shadow-md group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl">{cat.icon}</span>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400">
                {cat.count}
              </span>
            </div>
            <h3 class="font-serif font-bold text-lg text-stone-900 dark:text-stone-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
              {cat.name}
            </h3>
            <p class="text-xs text-stone-600 dark:text-stone-400 mt-2 leading-relaxed">
              {cat.desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-[11px] text-stone-500">
            <span>Risk: {cat.risk}</span>
            <span class="text-amber-600 font-medium group-hover:translate-x-0.5 transition-transform">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Pillar Guides -->
  <section class="py-16 bg-stone-100/70 dark:bg-stone-900/40 border-y border-stone-200 dark:border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 dark:text-stone-50 tracking-tight">
          Flagship Masterclasses & Pillar Guides
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-400 mt-2">
          5,000+ word deep-dives featuring KaTeX formulas, primary legal statutes, and empirical back-tests.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <article class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 p-6 flex flex-col justify-between shadow-xs hover:border-amber-500/50 transition-colors">
          <div>
            <div class="text-[11px] font-mono text-amber-600 uppercase tracking-wider font-semibold mb-2">
              Equities • Series 01
            </div>
            <h3 class="font-serif font-bold text-xl text-stone-900 dark:text-stone-100 mb-3">
              <a href={`${base}/blog/indian-equity-investing-complete-guide/`} class="hover:underline">
                The Indian Equity Landscape: Large, Mid, Small & Micro-Cap Realities
              </a>
            </h3>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed mb-4">
              Historical valuation multiples, survivorship bias in small caps, promoter governance checks, and factor investing evidence.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex justify-between items-center text-xs text-stone-500">
            <span>Verified 2026-10-15</span>
            <a href={`${base}/blog/indian-equity-investing-complete-guide/`} class="text-amber-600 font-medium hover:underline">Read Guide →</a>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 p-6 flex flex-col justify-between shadow-xs hover:border-amber-500/50 transition-colors">
          <div>
            <div class="text-[11px] font-mono text-emerald-600 uppercase tracking-wider font-semibold mb-2">
              Fixed Income • Series 03
            </div>
            <h3 class="font-serif font-bold text-xl text-stone-900 dark:text-stone-100 mb-3">
              <a href={`${base}/blog/indian-fixed-income-and-bonds-guide/`} class="hover:underline">
                Indian Fixed Income: From RBI Retail Direct to High-Yield Bonds
              </a>
            </h3>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed mb-4">
              How to build sovereign G-Sec ladders on NDS-OM, calculate Macaulay duration, and avoid credit contagion.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex justify-between items-center text-xs text-stone-500">
            <span>Verified 2026-10-15</span>
            <a href={`${base}/blog/indian-fixed-income-and-bonds-guide/`} class="text-emerald-600 font-medium hover:underline">Read Guide →</a>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 p-6 flex flex-col justify-between shadow-xs hover:border-amber-500/50 transition-colors">
          <div>
            <div class="text-[11px] font-mono text-red-600 uppercase tracking-wider font-semibold mb-2">
              Forensic Law • Series 08
            </div>
            <h3 class="font-serif font-bold text-xl text-stone-900 dark:text-stone-100 mb-3">
              <a href={`${base}/blog/financial-scams-fraud-laws-india-investor-protection/`} class="hover:underline">
                How Money Really Works: Indian Scams, BUDS Act & Red Flags
              </a>
            </h3>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed mb-4">
              Forensic teardown of Ponzi schemes, unauthorized collective investments, pump-and-dump syndicates, and SEBI SCORES 2.0.
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex justify-between items-center text-xs text-stone-500">
            <span>Verified 2026-10-15</span>
            <a href={`${base}/blog/financial-scams-fraud-laws-india-investor-protection/`} class="text-red-600 font-medium hover:underline">Read Guide →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Author Note Section -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-stone-900 rounded-2xl border border-stone-200 dark:border-stone-800 p-8 sm:p-12 shadow-sm">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="space-y-4 md:col-span-2">
          <div class="inline-flex items-center space-x-2 text-xs font-mono uppercase tracking-wider text-amber-600 font-semibold">
            <span>✍️ Editorial Manifesto</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 dark:text-stone-50">
            Why Artha Atlas was built by Chirag Singhal
          </h2>
          <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            As a software engineer living and investing in India, I grew exhausted with the misleading financial noise in the ecosystem: banks marketing low-yielding endowment policies as "pension plans", finfluencers promoting unregulated high-risk apps, and portals hiding credit default risks.
          </p>
          <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Artha Atlas is designed as a public quantitative resource — treating investing not as an emotional gamble, but as a disciplined mathematical exercise in capital allocation, statutory risk control, and tax optimization.
          </p>
          <div class="pt-2 flex items-center space-x-4 text-xs font-semibold">
            <a href={`${base}/about/`} class="text-amber-600 hover:underline">Read Full Author Bio →</a>
            <span class="text-stone-300 dark:text-stone-700">•</span>
            <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:underline">Support on BuyMeACoffee ☕</a>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-amber-50/70 dark:bg-stone-800/50 border border-amber-200 dark:border-stone-700 text-xs space-y-3">
          <div class="font-serif font-bold text-stone-900 dark:text-stone-100 text-sm">
            Core Editorial Principles
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Zero affiliate commission bias; independent research</span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Primary source citations from SEBI, RBI, and Income Tax Act</span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Real post-tax and inflation-adjusted return calculations</span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Prominent disclosure of historical failure modes and drawdowns</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
