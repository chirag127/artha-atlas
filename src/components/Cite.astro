---
interface Props {
  source: string;
  url?: string;
  accessed?: string;
  verified?: boolean;
}

const { source, url, accessed = '2026-10-15', verified = true } = Astro.props;
---
<span class="inline-flex items-center text-[11px] font-mono px-1.5 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400 border border-stone-200 dark:border-stone-700 mx-1">
  {verified && <span class="text-emerald-600 dark:text-emerald-400 mr-1 select-none">✓</span>}
  {url ? (
    <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 dark:hover:text-amber-400 underline decoration-dotted" title={`Verified on ${accessed}`}>
      [{source}]
    </a>
  ) : (
    <span title={`Verified on ${accessed}`}>[{source}]</span>
  )}
</span>
